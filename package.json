{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:api": "esbuild api_src/index.ts api_src/ai/health.ts api_src/ai/generate-model.ts api_src/ai/chat.ts api_src/ai/explain.ts api_src/ai/explain-change.ts api_src/ai/scan-diagram.ts api_src/ai/analyze-diagram.ts api_src/ai/interpret-change.ts api_src/ai/models/status.ts api_src/ai/test.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire as __vizlabCreateRequire } from 'node:module'; const require = __vizlabCreateRequire(import.meta.url);\" --outdir=api --allow-overwrite",
    "build": "vite build && npm run build:api",
    "postinstall": "npm run build",
    "render-build": "npm install && npm run build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/runTests.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
